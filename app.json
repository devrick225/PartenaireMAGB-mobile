{
  "expo": {
    "name": "PartenaireMAGB",
    "slug": "PartenaireMAGB",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ericsou.PartenaireMAGB",
      "infoPlist": {
        "NSCameraUsageDescription": "PartenaireMAGB a besoin d'accéder à votre caméra pour prendre des photos de profil.",
        "NSPhotoLibraryUsageDescription": "PartenaireMAGB a besoin d'accéder à vos photos pour choisir une photo de profil.",
        "NSPhotoLibraryAddUsageDescription": "PartenaireMAGB a besoin d'enregistrer des photos dans votre galerie."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.ericsou.PartenaireMAGB",
      "versionCode": 2,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "partenaireMagb"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "partenaireMagb",
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "PartenaireMAGB a besoin d'accéder à vos photos pour choisir une photo de profil.",
          "cameraPermission": "PartenaireMAGB a besoin d'accéder à votre caméra pour prendre des photos."
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "288369b8-cf95-436f-931d-02ea7d1c7c92"
      }
    },
    "owner": "ericsou"
  }
}
